FROM denoland/deno:alpine-2.1.9

WORKDIR /app

ENV DENO_DIR=/app/.cache/deno
ENV PORT=8003
ENV DB_PATH=/app/data/tracker.db

# 依存関係キャッシュの最適化
COPY deno.json ./
COPY src/ ./src/

# 事前キャッシュとデータディレクトリ権限付与
RUN mkdir -p /app/data /app/.cache/deno && \
    deno cache --allow-import src/webui/main.ts && \
    chown -R deno:deno /app

USER deno

EXPOSE 8003

CMD ["run", "--allow-net", "--allow-read", "--allow-write", "--allow-env", "--allow-ffi", "src/webui/main.ts"]
