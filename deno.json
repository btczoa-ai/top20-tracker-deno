{
  "name": "top10-volume-tracker-deno",
  "version": "1.0.0",
  "lock": false,
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --unstable-kv --allow-net --allow-read --allow-write --allow-env src/main.ts",
    "start:worker": "deno run --unstable-kv --allow-net --allow-read --allow-write --allow-env src/worker/main.ts",
    "start:webui": "deno run --unstable-kv --allow-net --allow-read --allow-write --allow-env src/webui/main.ts",
    "dev": "deno run --watch --unstable-kv --allow-net --allow-read --allow-write --allow-env src/main.ts",
    "test": "deno test --unstable-kv --allow-net --allow-read --allow-write --allow-env tests/",
    "check": "deno check --unstable-kv src/main.ts src/worker/main.ts src/webui/main.ts tests/*.ts"
  },
  "imports": {
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "@std/assert": "jsr:@std/assert@^1.0.8"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  }
}
