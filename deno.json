{
  "name": "top10-volume-tracker-deno",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi src/main.ts",
    "start:worker": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi src/worker/main.ts",
    "start:webui": "deno run --allow-net --allow-read --allow-write --allow-env --allow-ffi src/webui/main.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env --allow-ffi src/main.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-ffi tests/",
    "check": "deno check src/main.ts src/worker/main.ts src/webui/main.ts tests/*.ts"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "@std/assert": "jsr:@std/assert@^1.0.8"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  }
}
